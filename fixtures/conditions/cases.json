{
  "about": "Shared cases for input conditions (ADR 0037): the Rust engine (engine/conditions.rs) and the SPA (schema/conditions.ts) must hide exactly `hidden` for `values` (wire form). Decimals have scale 2. A form with `root` is a repeater's row (ADR 0044): `root.kinds` are the kinds of the record's form and each case's `root` its values (as its own conditions leave them), read by conditions with `\"scope\": \"root\"`.",
  "forms": [
    {
      "name": "an input shown for one value",
      "components": [
        { "name": "link_type", "valueType": "string" },
        { "name": "url", "valueType": "string", "shownWhen": { "op": "eq", "name": "link_type", "value": "external" } }
      ],
      "cases": [
        { "values": { "link_type": "external" }, "hidden": [] },
        { "values": { "link_type": "internal", "url": "https://x" }, "hidden": ["url"] },
        { "values": {}, "hidden": ["url"] }
      ]
    },
    {
      "name": "a section and an input inside it",
      "components": [
        { "name": "on_sale", "valueType": "bool" },
        {
          "type": "section",
          "shownWhen": { "op": "is_true", "name": "on_sale" },
          "components": [
            { "name": "discount", "valueType": "i32" },
            { "name": "note", "valueType": "string", "shownWhen": { "op": "filled", "name": "discount" } }
          ]
        }
      ],
      "cases": [
        { "values": { "on_sale": true, "discount": 10 }, "hidden": [] },
        { "values": { "on_sale": true, "discount": null }, "hidden": ["note"] },
        { "values": { "on_sale": false, "discount": 10, "note": "x" }, "hidden": ["discount", "note"] }
      ]
    },
    {
      "name": "canonical numbers and a chain through a hidden field",
      "components": [
        { "name": "price", "valueType": "decimal" },
        { "name": "count", "valueType": "i64" },
        { "name": "featured", "valueType": "bool", "shownWhen": { "op": "is_in", "name": "price", "values": ["10.50", "20"] } },
        { "name": "badge", "valueType": "string", "shownWhen": { "op": "is_true", "name": "featured" } },
        { "name": "lucky", "valueType": "string", "shownWhen": { "op": "eq", "name": "count", "value": "7" } }
      ],
      "cases": [
        { "values": { "price": "10.5", "featured": true, "count": "007" }, "hidden": [] },
        { "values": { "price": "20.00", "featured": false, "count": "8" }, "hidden": ["badge", "lucky"] },
        { "values": { "price": "1", "featured": true, "count": "7" }, "hidden": ["badge", "featured"] },
        { "values": { "price": "10.504", "featured": true, "count": "7" }, "hidden": ["badge", "featured"] }
      ]
    },
    {
      "name": "combined conditions, ne and blank text",
      "components": [
        { "name": "a", "valueType": "string" },
        { "name": "b", "valueType": "bool" },
        { "name": "kind", "valueType": "string" },
        {
          "name": "either",
          "valueType": "string",
          "shownWhen": { "op": "any", "conditions": [{ "op": "filled", "name": "a" }, { "op": "is_true", "name": "b" }] }
        },
        {
          "name": "both",
          "valueType": "string",
          "shownWhen": { "op": "all", "conditions": [{ "op": "filled", "name": "a" }, { "op": "ne", "name": "kind", "value": "draft" }] }
        }
      ],
      "cases": [
        { "values": { "a": "x", "b": false, "kind": "final" }, "hidden": [] },
        { "values": { "a": "   ", "b": true, "kind": "final" }, "hidden": ["both"] },
        { "values": { "a": "x", "b": false, "kind": "draft" }, "hidden": ["both"] },
        { "values": { "a": "", "b": false, "kind": null }, "hidden": ["both", "either"] }
      ]
    },
    {
      "name": "a field with an unconditional input is always shown",
      "components": [
        { "name": "on", "valueType": "bool" },
        { "name": "code", "valueType": "string", "shownWhen": { "op": "is_true", "name": "on" } },
        { "type": "section", "components": [{ "name": "code", "valueType": "string" }] }
      ],
      "cases": [{ "values": { "on": false }, "hidden": [] }]
    },
    {
      "name": "UUIDs compared in canonical form, literals and values as written",
      "components": [
        { "name": "owner", "valueType": "uuid" },
        { "name": "mine", "valueType": "string", "shownWhen": { "op": "eq", "name": "owner", "value": "0C7E1D2A5B3F4E6A9D8C1A2B3C4D5E6F" } },
        { "name": "listed", "valueType": "string", "shownWhen": { "op": "is_in", "name": "owner", "values": ["{0c7e1d2a-5b3f-4e6a-9d8c-1a2b3c4d5e6f}"] } },
        {
          "name": "other",
          "valueType": "string",
          "shownWhen": { "op": "any", "conditions": [{ "op": "ne", "name": "owner", "value": "urn:uuid:0c7e1d2a-5b3f-4e6a-9d8c-1a2b3c4d5e6f" }] }
        }
      ],
      "cases": [
        { "values": { "owner": "0c7e1d2a-5b3f-4e6a-9d8c-1a2b3c4d5e6f" }, "hidden": ["other"] },
        { "values": { "owner": "0C7E1D2A-5B3F-4E6A-9D8C-1A2B3C4D5E6F" }, "hidden": ["other"] },
        { "values": { "owner": "0c7e1d2a5b3f4e6a9d8c1a2b3c4d5e6f" }, "hidden": ["other"] },
        { "values": { "owner": "11111111-1111-1111-1111-111111111111" }, "hidden": ["listed", "mine"] },
        { "values": {}, "hidden": ["listed", "mine"] }
      ]
    },
    {
      "name": "a repeater row reading the record's form",
      "root": { "kinds": { "kind": "string", "price": "decimal" } },
      "components": [
        { "name": "correct", "valueType": "bool" },
        {
          "name": "hint",
          "valueType": "string",
          "shownWhen": {
            "op": "all",
            "conditions": [
              { "op": "is_true", "name": "correct" },
              { "op": "eq", "name": "kind", "scope": "root", "value": "choice" }
            ]
          }
        },
        { "name": "discount", "valueType": "string", "shownWhen": { "op": "is_in", "name": "price", "scope": "root", "values": ["10.5", "20"] } },
        { "name": "note", "valueType": "string", "shownWhen": { "op": "filled", "name": "hint" } }
      ],
      "cases": [
        { "values": { "correct": true, "hint": "h" }, "root": { "kind": "choice", "price": "10.50" }, "hidden": [] },
        { "values": { "correct": true, "hint": "h" }, "root": { "kind": "blank", "price": "20.00" }, "hidden": ["hint", "note"] },
        { "values": { "correct": false }, "root": { "kind": "choice", "price": "3" }, "hidden": ["discount", "hint", "note"] },
        { "values": { "correct": true, "hint": "h" }, "root": {}, "hidden": ["discount", "hint", "note"] },
        { "values": { "correct": true, "hint": "h" }, "root": { "kind": "choice", "price": null }, "hidden": ["discount"] }
      ]
    }
  ]
}
