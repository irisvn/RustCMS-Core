[package]
name = "{{ name }}"
version = "0.1.0"
edition = "2024"
publish = false

[package.metadata.rustcms]
version = "{{ rustcms_version }}"

[dependencies]
rustcms = {{ rustcms_dep }}
sea-orm = { version = "={{ sea_orm_version }}", default-features = false, features = ["macros", "with-chrono", "with-uuid", "with-rust_decimal", "with-json"] }
sea-orm-migration = { version = "={{ sea_orm_version }}", default-features = false }
anyhow = "1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[dev-dependencies]
rustcms-testing = {{ rustcms_testing_dep }}
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
{% if not in_workspace %}
[workspace]
{% endif %}
