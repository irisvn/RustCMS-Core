//! Application assembly: providers, services and routes.

use rustcms::prelude::*;

pub fn build(config: Config) -> AppBuilder {
    let mut app = AppBuilder::new(config);
    // The JSON API (src/http/api); its permissions come from its routes.
    let api = crate::http::api::routes();
    // Admin sessions under /admin, API tokens elsewhere; declare your permissions here.
    app.provider(AuthProvider::new().api_permissions(&api));
    // Resources appear in the admin panel at /admin (`rustcms make:resource <Model>`).
    app.provider(
        AdminProvider::new()
            .brand("{{ name }}")
            // rustcms:resources
    );
    // Mounted and listed by `rustcms route:list` from the same declarations.
    api.register(&mut app);
    app
}
