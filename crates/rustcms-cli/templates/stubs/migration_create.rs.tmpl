use rustcms::migration::*;
use rustcms::async_trait;

#[derive(DeriveMigrationName)]
pub struct Migration;

#[async_trait]
impl MigrationTrait for Migration {
    /// Schema change and migration record commit together, also on SQLite
    /// (whose default is no transaction), so a failed run can be retried.
    fn use_transaction(&self) -> Option<bool> {
        Some(true)
    }

    /// `create_table` and the column helpers (`instant`, `instant_now`) give the
    /// same table on SQLite, PostgreSQL and MySQL, and skip what already exists
    /// (MySQL commits DDL statement by statement, so a failed run is retried).
    async fn up(&self, manager: &SchemaManager) -> Result<(), DbErr> {
        create_table(
            manager,
            Table::create()
                .table({{ iden }}::Table)
                .col(ColumnDef::new({{ iden }}::Id).big_integer().not_null().auto_increment().primary_key())
                .col(ColumnDef::new({{ iden }}::CreatedAt).instant_now(manager).not_null())
                .col(ColumnDef::new({{ iden }}::UpdatedAt).instant_now(manager).not_null())
                .to_owned(),
        )
        .await
    }

    async fn down(&self, manager: &SchemaManager) -> Result<(), DbErr> {
        drop_table(manager, {{ iden }}::Table).await
    }
}

#[derive(DeriveIden)]
enum {{ iden }} {
    Table,
    Id,
    CreatedAt,
    UpdatedAt,
}
